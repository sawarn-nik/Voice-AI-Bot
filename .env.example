# ============================================================
# Darwix AI Voice Agent — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Deepgram (ASR / STT) ---
DEEPGRAM_API_KEY=...

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=...

# --- Twilio (Voice / PSTN) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# --- Pinecone (Vector DB) ---
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=darwix-kb

# --- Qdrant (alternative local vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=darwix_kb

# --- Redis (nudge deduplication / cooldowns) ---
REDIS_URL=redis://localhost:6379

# --- App Config ---
APP_ENV=development           # development | production
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# --- Knowledge Base ---
KB_CHUNK_SIZE=400
KB_CHUNK_OVERLAP=80
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_TOP_K=5

# --- Voice Agent ---
VOICE_AGENT_MODEL=gpt-4o
VOICE_AGENT_USE_CASE=health_insurance_lead
VOICE_AGENT_LANGUAGE=en-US

# --- Live Insights (Q4) ---
NUDGE_CONFIDENCE_THRESHOLD=0.65
NUDGE_COOLDOWN_SECONDS=30
NUDGE_MAX_ACTIVE=5
STREAM_CHUNK_SECONDS=3
